# ============================================
# CUIN v2 - infra/docker-compose.yml configuration
# ============================================
# Copy to infra/.env and adjust for your host. docker compose reads a
# .env file in the SAME directory as the compose file automatically.
# ============================================

# --------------------------------------------
# Public access
# --------------------------------------------
# The address a BROWSER will type in to reach this deployment. Next.js
# bakes NEXT_PUBLIC_API_URL/WS_URL into the client bundle at build time
# (see frontend/Dockerfile) -- changing this after building requires a
# rebuild (`docker compose build frontend`), not just a restart.
PUBLIC_HOST=10.11.200.99

# --------------------------------------------
# Host port mappings
# --------------------------------------------
# Left side of each is the HOST port; change these if something else on
# the machine already occupies them (common on a shared box). Services
# still talk to each other over the internal compose network at their
# standard ports (5432/7687/6379) regardless of these host mappings.
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5436
NEO4J_HTTP_PORT=7476
NEO4J_BOLT_PORT=7689
REDIS_PORT=6381
PGADMIN_PORT=18080
REDIS_INSIGHT_PORT=15540

# --------------------------------------------
# Credentials (change for anything beyond local/demo use)
# --------------------------------------------
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
POSTGRES_DB=cuin_db
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
PGADMIN_EMAIL=admin@cuin.com
PGADMIN_PASSWORD=password123

# --------------------------------------------
# File ownership (bind-mounted volumes)
# --------------------------------------------
# Must match the HOST user that owns backend/data, backend/data_source,
# etc. (run `id -u` / `id -g` to find yours) -- bind mounts keep the
# host's file ownership, so the container's process needs a matching
# uid/gid to read/write them. Mismatches surface as "Permission denied"
# errors from inside the backend container the first time it tries to
# write a run artifact.
BACKEND_UID=1000
BACKEND_GID=1000

# --------------------------------------------
# DuckDB pipeline resource caps
# --------------------------------------------
# See pipeline/duckdb_orchestrator.py -- keeps the matching engine from
# claiming all host resources on a shared machine. Raise on a dedicated host.
DUCKDB_MEMORY_LIMIT=4GB
DUCKDB_THREADS=4
