# Database Configuration
# Points at the infra/docker-compose.yml stack's host port mappings
# (postgres/neo4j/redis run there; only backend+frontend run locally
# for dev). See infra/.env for the source of truth on these ports.
DATABASE_URL=postgresql://admin:password123@localhost:5436/cuin_db
DB_POOL_SIZE=5

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7689
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# Redis Configuration
REDIS_URL=redis://localhost:6381/0

# App Settings
LOG_LEVEL=INFO
DEBUG=True
